{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"]
  },
  "include": [
    "src/contracts/ipc/**/*.ts",
    "src/electron/renderer/**/*.ts",
    "src/electron/renderer/**/*.tsx",
