{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node", "electron"]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/application/**/*.ts",
    "src/infrastructure/**/*.ts",
    "src/electron/main/**/*.ts",
    "forge.env.d.ts",
    "forge.config.ts",
    "vite.main.config.ts",
    "drizzle.config.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/electron/renderer"]
}
